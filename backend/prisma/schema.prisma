// As sete entidades correspondem ao glossário da seção 12 do PRD e ao
// diagrama de modelo de dados (documentacao_projeto/diagrama-modelo-dados.png).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Atendente {
  id             String          @id @default(uuid())
  nome           String
  email          String          @unique
  senha          String
  clientes       Cliente[]
  interacoes     Interacao[]
  emAtendimentos EmAtendimento[]
  criadoEm       DateTime        @default(now())

  @@map("atendentes")
}

model Cliente {
  id          String    @id @default(uuid())
  nome        String
  contato     String
  atendenteId String
  atendente   Atendente @relation(fields: [atendenteId], references: [id])
  entregas    Entrega[]
  criadoEm    DateTime  @default(now())

  @@map("clientes")
}

model Entrega {
  id          String                @id @default(uuid())
  clienteId   String
  cliente     Cliente               @relation(fields: [clienteId], references: [id])
  dataEntrega DateTime
  marcos      MarcoAcompanhamento[]

  @@map("entregas")
}

enum TipoMarco {
  SETE_DIAS
  DOIS_MESES
  UM_ANO
}

model MarcoAcompanhamento {
  id        String    @id @default(uuid())
  entregaId String
  entrega   Entrega   @relation(fields: [entregaId], references: [id])
  tipo      TipoMarco
  dataAlvo  DateTime
  lembrete  Lembrete?

  @@map("marcos_acompanhamento")
}

enum StatusLembrete {
  PENDENTE
  CONCLUIDO
}

model Lembrete {
  id            String              @id @default(uuid())
  marcoId       String              @unique
  marco         MarcoAcompanhamento @relation(fields: [marcoId], references: [id])
  status        StatusLembrete      @default(PENDENTE)
  criadoEm      DateTime            @default(now())
  concluidoEm   DateTime?
  emAtendimento EmAtendimento?
  interacoes    Interacao[]

  @@map("lembretes")
}

model EmAtendimento {
  id          String    @id @default(uuid())
  lembreteId  String    @unique
  lembrete    Lembrete  @relation(fields: [lembreteId], references: [id])
  atendenteId String
  atendente   Atendente @relation(fields: [atendenteId], references: [id])
  iniciadoEm  DateTime  @default(now())

  @@map("em_atendimento")
}

model Interacao {
  id              String    @id @default(uuid())
  lembreteId      String
  lembrete        Lembrete  @relation(fields: [lembreteId], references: [id])
  atendenteId     String
  atendente       Atendente @relation(fields: [atendenteId], references: [id])
  conteudo        String
  respostaCliente String?
  criadoEm        DateTime  @default(now())

  @@map("interacoes")
}
