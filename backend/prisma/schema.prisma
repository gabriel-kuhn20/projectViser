generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id       Int       @id @default(autoincrement())
  nome     String
  email    String?
  cpf      String?
  criadoEm DateTime  @default(now())
  clientes Cliente[]
  usuario  Usuario?

  @@map("pessoa")
}

model Usuario {
  id                  Int             @id @default(autoincrement())
  pessoaId            Int             @unique
  email               String          @unique
  senha               String
  papelAcesso         PapelAcesso     @default(atendente)
  criadoEm            DateTime        @default(now())
  clientesResponsavel Cliente[]       @relation("ClienteResponsavel")
  emAtendimentos      EmAtendimento[]
  interacoes          Interacao[]
  pessoa              Pessoa          @relation(fields: [pessoaId], references: [id])

  @@map("usuario")
}

model Cliente {
  id            Int          @id @default(autoincrement())
  pessoaId      Int
  contato       String
  endereco      String?
  responsavelId Int?
  criadoEm      DateTime     @default(now())
  pessoa        Pessoa       @relation(fields: [pessoaId], references: [id])
  responsavel   Usuario?     @relation("ClienteResponsavel", fields: [responsavelId], references: [id])
  tags          ClienteTag[]
  entregas      Entrega[]

  @@map("cliente")
}

model Tag {
  id       Int          @id @default(autoincrement())
  nome     String
  criadoEm DateTime     @default(now())
  clientes ClienteTag[]

  @@map("tag")
}

model ClienteTag {
  clienteId   Int
  tagId       Int
  vinculadoEm DateTime @default(now())
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  tag         Tag      @relation(fields: [tagId], references: [id])

  @@id([clienteId, tagId])
  @@map("cliente_tag")
}

model Entrega {
  id          Int                   @id @default(autoincrement())
  clienteId   Int
  dataEntrega DateTime
  criadoEm    DateTime              @default(now())
  cliente     Cliente               @relation(fields: [clienteId], references: [id])
  marcos      MarcoAcompanhamento[]

  @@map("entrega")
}

model TipoMarco {
  id       Int                   @id @default(autoincrement())
  nome     String                @unique
  criadoEm DateTime              @default(now())
  marcos   MarcoAcompanhamento[]

  @@map("tipo_marco")
}

model MarcoAcompanhamento {
  id          Int        @id @default(autoincrement())
  entregaId   Int
  tipoMarcoId Int
  dataAlvo    DateTime
  criadoEm    DateTime   @default(now())
  lembretes   Lembrete[]
  entrega     Entrega    @relation(fields: [entregaId], references: [id])
  tipoMarco   TipoMarco  @relation(fields: [tipoMarcoId], references: [id])

  @@unique([entregaId, tipoMarcoId])
  @@map("marco_acompanhamento")
}

model Lembrete {
  id             Int                 @id @default(autoincrement())
  marcoId        Int
  status         StatusLembrete      @default(pendente)
  criadoEm       DateTime            @default(now())
  concluidoEm    DateTime?
  emAtendimentos EmAtendimento?
  interacoes     Interacao[]
  marco          MarcoAcompanhamento @relation(fields: [marcoId], references: [id])

  @@map("lembrete")
}

model EmAtendimento {
  id         Int      @id @default(autoincrement())
  lembreteId Int      @unique
  usuarioId  Int
  iniciadoEm DateTime @default(now())
  lembrete   Lembrete @relation(fields: [lembreteId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("em_atendimento")
}

model Interacao {
  id              Int      @id @default(autoincrement())
  lembreteId      Int
  usuarioId       Int
  conteudo        String
  respostaCliente String?
  criadoEm        DateTime @default(now())
  lembrete        Lembrete @relation(fields: [lembreteId], references: [id])
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("interacao")
}

enum StatusLembrete {
  pendente
  concluido
}

enum PapelAcesso {
  admin
  atendente
}
