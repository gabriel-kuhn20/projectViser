generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id       Int       @id @default(autoincrement())
  nome     String
  email    String?
  cpf      String?
  criadoEm DateTime  @default(now())
  clientes Cliente[]
  usuario  Usuario?

  @@map("pessoa")
}

model Usuario {
  id                  Int             @id @default(autoincrement())
  pessoaId            Int             @unique
  email               String          @unique
  senha               String
  papelAcesso         PapelAcesso     @default(atendente)
  // desativar tira o acesso sem apagar a conta — o histórico de interações continua com o nome de quem atendeu
  ativo               Boolean         @default(true)
  // todo token emitido ANTES desta data deixa de valer — preenchido ao trocar ou redefinir a senha,
  // para quem copiou um token antigo não continuar dentro até as 8h do vencimento
  sessoesValidasDesde DateTime?
  criadoEm            DateTime        @default(now())
  clientesResponsavel Cliente[]       @relation("ClienteResponsavel")
  emAtendimentos      EmAtendimento[]
  interacoes          Interacao[]
  pessoa              Pessoa          @relation(fields: [pessoaId], references: [id])
  tokensRecuperacao   TokenRecuperacaoSenha[]

  @@map("usuario")
}

// UC12 · Recuperar senha (RF20)
// o token que vai no link do e-mail NUNCA é gravado aqui — só o hash dele
model TokenRecuperacaoSenha {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  // SHA-256 do token enviado por e-mail: se o banco vazar, os links em aberto continuam inúteis
  tokenHash String    @unique
  expiraEm  DateTime
  // preenchido no momento do uso — token usado não vale de novo, nem se a pessoa reabrir o link
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  // a redefinição invalida os tokens pendentes da mesma conta, e essa busca é por usuarioId
  @@index([usuarioId])
  @@map("token_recuperacao_senha")
}

// UC01 · Entrar no sistema (RF01): encerrar a sessão
// lista de tokens que o logout derrubou. O JWT é assinado e não depende do banco, então a única
// forma de ele deixar de valer antes das 8h é o servidor lembrar que aquele `jti` foi encerrado
model TokenRevogado {
  // identificador único do token (claim `jti` do JWT)
  jti      String   @id
  // quando o token venceria sozinho — depois disso a linha não serve mais e a rotina de limpeza apaga
  expiraEm DateTime

  // a limpeza diária busca por vencimento
  @@index([expiraEm])
  @@map("token_revogado")
}

model Cliente {
  id            Int          @id @default(autoincrement())
  pessoaId      Int
  contato       String
  endereco      String?
  responsavelId Int?
  criadoEm      DateTime     @default(now())
  pessoa        Pessoa       @relation(fields: [pessoaId], references: [id])
  responsavel   Usuario?     @relation("ClienteResponsavel", fields: [responsavelId], references: [id])
  tags          ClienteTag[]
  entregas      Entrega[]

  @@map("cliente")
}

model Tag {
  id       Int          @id @default(autoincrement())
  nome     String
  criadoEm DateTime     @default(now())
  clientes ClienteTag[]

  @@map("tag")
}

model ClienteTag {
  clienteId   Int
  tagId       Int
  vinculadoEm DateTime @default(now())
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  tag         Tag      @relation(fields: [tagId], references: [id])

  @@id([clienteId, tagId])
  @@map("cliente_tag")
}

model Entrega {
  id          Int                   @id @default(autoincrement())
  clienteId   Int
  dataEntrega DateTime
  // produto comprado em texto livre, digitado pelo atendente (PRD seção 8: sem catálogo de produtos)
  produto     String
  criadoEm    DateTime              @default(now())
  cliente     Cliente               @relation(fields: [clienteId], references: [id])
  marcos      MarcoAcompanhamento[]

  @@map("entrega")
}

model TipoMarco {
  id              Int                   @id @default(autoincrement())
  // rótulo das abas e do painel (ex: "7 dias")
  nome            String                @unique
  // dias após a entrega em que o contato é feito — definido pelo administrador
  // (eram 7, 60 e 365 fixos no código; continuam como valores iniciais do seed)
  diasAposEntrega Int                   @unique
  // inativo para de gerar marcos novos e sai das abas; os lembretes já gerados continuam
  ativo           Boolean               @default(true)
  criadoEm        DateTime              @default(now())
  marcos          MarcoAcompanhamento[]

  @@map("tipo_marco")
}

model MarcoAcompanhamento {
  id          Int        @id @default(autoincrement())
  entregaId   Int
  tipoMarcoId Int
  dataAlvo    DateTime
  criadoEm    DateTime   @default(now())
  lembretes   Lembrete[]
  entrega     Entrega    @relation(fields: [entregaId], references: [id])
  tipoMarco   TipoMarco  @relation(fields: [tipoMarcoId], references: [id])

  @@unique([entregaId, tipoMarcoId])
  @@map("marco_acompanhamento")
}

model Lembrete {
  id             Int                 @id @default(autoincrement())
  marcoId        Int
  status         StatusLembrete      @default(pendente)
  criadoEm       DateTime            @default(now())
  concluidoEm    DateTime?
  emAtendimentos EmAtendimento?
  interacoes     Interacao[]
  marco          MarcoAcompanhamento @relation(fields: [marcoId], references: [id])

  @@map("lembrete")
}

model EmAtendimento {
  id         Int      @id @default(autoincrement())
  lembreteId Int      @unique
  usuarioId  Int
  iniciadoEm DateTime @default(now())
  lembrete   Lembrete @relation(fields: [lembreteId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("em_atendimento")
}

model Interacao {
  id              Int      @id @default(autoincrement())
  lembreteId      Int
  usuarioId       Int
  conteudo        String
  respostaCliente String?
  criadoEm        DateTime @default(now())
  // preenchido quando o texto é corrigido; a tela mostra "(editado)" para o histórico não mudar sem aviso
  editadoEm       DateTime?
  lembrete        Lembrete @relation(fields: [lembreteId], references: [id])
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("interacao")
}

enum StatusLembrete {
  pendente
  concluido
}

enum PapelAcesso {
  admin
  atendente
}
